diff --git a/privilege_darwin.go b/privilege_darwin.go
new file mode 100644
index 0000000..d579b09
--- /dev/null
+++ b/privilege_darwin.go
@@ -0,0 +1,36 @@
+//go:build darwin
+
+package main
+
+import (
+	"fmt"
+	"os"
+	"syscall"
+)
+
+const runtimeUID = 65534
+
+// platformPrivilegeDrop is invoked only after libpcap has opened and
+// configured the BPF handle. No stack goroutine or outbound socket exists at
+// that point, so every direct connection is owned by runtimeUID while the
+// already-open capture descriptor remains usable.
+func platformPrivilegeDrop() func() error {
+	return func() error {
+		if os.Geteuid() != 0 {
+			return fmt.Errorf("root is required to open the macOS capture device")
+		}
+		if err := syscall.Setgroups([]int{runtimeUID}); err != nil {
+			return fmt.Errorf("set supplementary groups: %w", err)
+		}
+		if err := syscall.Setgid(runtimeUID); err != nil {
+			return fmt.Errorf("set runtime gid: %w", err)
+		}
+		if err := syscall.Setuid(runtimeUID); err != nil {
+			return fmt.Errorf("set runtime uid: %w", err)
+		}
+		if os.Geteuid() != runtimeUID || os.Getegid() != runtimeUID {
+			return fmt.Errorf("runtime identity did not change")
+		}
+		return nil
+	}
+}
