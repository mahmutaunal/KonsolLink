+package proxy
+
+import (
+	"net"
+	"testing"
+
+	"github.com/miekg/dns"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestDomainTrackerLearnsAllowedAnswersAndCNAMEsOnly(t *testing.T) {
+	tracker := NewDomainTracker([]string{"discord.com"})
+	message := new(dns.Msg)
+	message.SetQuestion("gateway.discord.com.", dns.TypeA)
+	message.Answer = []dns.RR{
+		&dns.CNAME{
+			Hdr:    dns.RR_Header{Name: "gateway.discord.com.", Rrtype: dns.TypeCNAME, Class: dns.ClassINET, Ttl: 60},
+			Target: "edge.example.net.",
+		},
+		&dns.A{
+			Hdr: dns.RR_Header{Name: "edge.example.net.", Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 60},
+			A:   net.ParseIP("203.0.113.20"),
+		},
+		&dns.A{
+			Hdr: dns.RR_Header{Name: "unrelated.example.", Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 60},
+			A:   net.ParseIP("203.0.113.21"),
+		},
+	}
+
+	assert.True(t, tracker.Learn(message))
+	assert.True(t, tracker.Contains(net.ParseIP("203.0.113.20")))
+	assert.False(t, tracker.Contains(net.ParseIP("203.0.113.21")))
+}
+
+func TestDomainTrackerRejectsUnrelatedQuestionAndZeroTTL(t *testing.T) {
+	tracker := NewDomainTracker([]string{"discord.com"})
+	for _, test := range []struct {
+		question string
+		ttl      uint32
+		address  string
+	}{
+		{question: "example.com.", ttl: 60, address: "203.0.113.30"},
+		{question: "discord.com.", ttl: 0, address: "203.0.113.31"},
+	} {
+		message := new(dns.Msg)
+		message.SetQuestion(test.question, dns.TypeA)
+		message.Answer = []dns.RR{&dns.A{
+			Hdr: dns.RR_Header{Name: test.question, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: test.ttl},
+			A:   net.ParseIP(test.address),
+		}}
+		assert.False(t, tracker.Learn(message))
+		assert.False(t, tracker.Contains(net.ParseIP(test.address)))
+	}
+}
