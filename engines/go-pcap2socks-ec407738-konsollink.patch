@@ -0,0 +1,61 @@
+package engine
+
+import (
+	"errors"
+	"net"
+	"testing"
+
+	"github.com/DaniilSokolyuk/go-pcap2socks/cfg"
+	"github.com/DaniilSokolyuk/go-pcap2socks/core/device"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func testOptions(t *testing.T, source *device.MemSource) Options {
+	t.Helper()
+	_, network, err := net.ParseCIDR("172.24.0.0/16")
+	require.NoError(t, err)
+	return Options{
+		Config: &cfg.Config{Outbounds: []cfg.Outbound{{
+			Direct: &cfg.OutboundDirect{},
+		}}},
+		Interface: net.Interface{Name: "mem0"},
+		Network: &device.NetworkConfig{
+			Network:  network,
+			LocalIP:  net.ParseIP("172.24.2.1"),
+			LocalMAC: net.HardwareAddr{0x02, 0, 0, 0, 0, 1},
+			MTU:      1486,
+		},
+		Source: source,
+	}
+}
+
+func TestAfterCaptureOpenRunsBeforeStartReturns(t *testing.T) {
+	source := device.NewMemSource(1)
+	opts := testOptions(t, source)
+	called := false
+	opts.AfterCaptureOpen = func() error {
+		called = true
+		return nil
+	}
+
+	eng, err := Start(opts)
+	require.NoError(t, err)
+	assert.True(t, called)
+	require.NoError(t, eng.Close())
+}
+
+func TestAfterCaptureOpenFailureClosesCapture(t *testing.T) {
+	source := device.NewMemSource(1)
+	opts := testOptions(t, source)
+	opts.AfterCaptureOpen = func() error { return errors.New("injected privilege failure") }
+
+	eng, err := Start(opts)
+	assert.Nil(t, eng)
+	require.ErrorContains(t, err, "after capture open: injected privilege failure")
+	select {
+	case <-source.Done():
+	default:
+		t.Fatal("capture source remained open after privilege callback failure")
+	}
+}
