diff --git a/proxy/doh.go b/proxy/doh.go
new file mode 100644
index 0000000..af16628
--- /dev/null
+++ b/proxy/doh.go
@@ -0,0 +1,111 @@
+package proxy
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"time"
+
+	"github.com/miekg/dns"
+)
+
+const maxDNSMessageBytes = 65_535
+
+var discordDoHEndpoints = []string{
+	"https://cloudflare-dns.com/dns-query",
+	"https://dns.google/dns-query",
+}
+
+type dnsExchanger interface {
+	Exchange(*dns.Msg) (*dns.Msg, error)
+}
+
+type dohClient struct {
+	client    *http.Client
+	endpoints []string
+}
+
+func newDiscordDoHClient() dnsExchanger {
+	// Keep both fallback attempts inside the helper's bounded startup window.
+	// A transient endpoint failure is retried by the policy bootstrap loop.
+	dialer := &net.Dialer{Timeout: 3 * time.Second, KeepAlive: 30 * time.Second}
+	return &dohClient{
+		client: &http.Client{
+			Timeout: 4 * time.Second,
+			Transport: &http.Transport{
+				Proxy: nil,
+				DialContext: func(ctx context.Context, _, address string) (net.Conn, error) {
+					return dialer.DialContext(ctx, "tcp4", address)
+				},
+				ForceAttemptHTTP2:   true,
+				TLSHandshakeTimeout: 3 * time.Second,
+			},
+		},
+		endpoints: append([]string(nil), discordDoHEndpoints...),
+	}
+}
+
+func (d *dohClient) Exchange(message *dns.Msg) (*dns.Msg, error) {
+	if message == nil || len(message.Question) != 1 {
+		return nil, fmt.Errorf("Discord DoH requires exactly one question")
+	}
+	query := message.Copy()
+	query.Id = 0
+	wire, err := query.Pack()
+	if err != nil {
+		return nil, fmt.Errorf("pack Discord DoH query: %w", err)
+	}
+	var lastErr error
+	for _, endpoint := range d.endpoints {
+		request, err := http.NewRequest(http.MethodPost, endpoint, bytes.NewReader(wire))
+		if err != nil {
+			return nil, fmt.Errorf("create Discord DoH request: %w", err)
+		}
+		request.Header.Set("Accept", "application/dns-message")
+		request.Header.Set("Content-Type", "application/dns-message")
+		response, err := d.client.Do(request)
+		if err != nil {
+			lastErr = err
+			continue
+		}
+		body, readErr := io.ReadAll(io.LimitReader(response.Body, maxDNSMessageBytes+1))
+		closeErr := response.Body.Close()
+		if readErr != nil {
+			lastErr = readErr
+			continue
+		}
+		if closeErr != nil {
+			lastErr = closeErr
+			continue
+		}
+		if response.StatusCode < 200 || response.StatusCode >= 300 {
+			lastErr = fmt.Errorf("Discord DoH returned HTTP %d", response.StatusCode)
+			continue
+		}
+		if len(body) > maxDNSMessageBytes {
+			lastErr = fmt.Errorf("Discord DoH response exceeds size limit")
+			continue
+		}
+		answer := new(dns.Msg)
+		if err := answer.Unpack(body); err != nil {
+			lastErr = err
+			continue
+		}
+		if !answer.Response || answer.Opcode != query.Opcode || len(answer.Question) != 1 ||
+			answer.Question[0].Name != query.Question[0].Name ||
+			answer.Question[0].Qtype != query.Question[0].Qtype ||
+			answer.Question[0].Qclass != query.Question[0].Qclass {
+			lastErr = fmt.Errorf("Discord DoH response does not match the question")
+			continue
+		}
+		answer.Id = message.Id
+		return answer, nil
+	}
+	if lastErr == nil {
+		lastErr = fmt.Errorf("no Discord DoH endpoints configured")
+	}
+	return nil, lastErr
+}
