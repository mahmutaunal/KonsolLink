+
+func TestDiscordDoHPreservesQuestionAndCallerID(t *testing.T) {
+	server := httptest.NewTLSServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+		require.Equal(t, http.MethodPost, request.Method)
+		require.Equal(t, "application/dns-message", request.Header.Get("Content-Type"))
+		wire, err := io.ReadAll(request.Body)
+		require.NoError(t, err)
+		query := new(dns.Msg)
+		require.NoError(t, query.Unpack(wire))
+		answer := new(dns.Msg)
+		answer.SetReply(query)
+		answer.Answer = []dns.RR{&dns.A{
+			Hdr: dns.RR_Header{Name: query.Question[0].Name, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 300},
+			A:   net.IPv4(203, 0, 113, 42),
+		}}
+		response, err := answer.Pack()
+		require.NoError(t, err)
+		writer.Header().Set("Content-Type", "application/dns-message")
+		_, err = writer.Write(response)
+		require.NoError(t, err)
+	}))
+	defer server.Close()
+	transport := server.Client().Transport.(*http.Transport).Clone()
+	transport.TLSClientConfig = &tls.Config{InsecureSkipVerify: true} // test server only
+	client := &dohClient{client: &http.Client{Transport: transport}, endpoints: []string{server.URL}}
+	query := new(dns.Msg)
+	query.SetQuestion("discord.com.", dns.TypeA)
+	query.Id = 4242
+	response, err := client.Exchange(query)
+	require.NoError(t, err)
+	assert.Equal(t, uint16(4242), response.Id)
+	require.Len(t, response.Answer, 1)
+}
+
+func TestDomainTrackerMatchesOnlyDiscordAddressQuestions(t *testing.T) {
+	tracker := NewDomainTracker([]string{"discord.com"})
+	for _, test := range []struct {
+		name  string
+		qtype uint16
+		want  bool
+	}{
+		{"discord.com.", dns.TypeA, true},
+		{"gateway.discord.com.", dns.TypeAAAA, true},
+		{"example.com.", dns.TypeA, false},
+		{"discord.com.", dns.TypeTXT, false},
+	} {
+		message := new(dns.Msg)
+		message.SetQuestion(test.name, test.qtype)
+		assert.Equal(t, test.want, tracker.MatchesQuestion(message))
+	}
+}
diff --git a/proxy/domain_tracker.go b/proxy/domain_tracker.go
new file mode 100644
index 0000000..b027d7c
--- /dev/null
+++ b/proxy/domain_tracker.go
@@ -0,0 +1,194 @@
+package proxy
+
+import (
+	"net"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/miekg/dns"
+)
+
+// DomainTracker records short-lived IP authority only from DNS answers whose
+// question belongs to the configured service roots. It never turns unrelated
+// answers in the same packet into routing authority.
+type DomainTracker struct {
+	mu     sync.Mutex
+	roots  []string
+	leases map[string]DomainLease
+}
+
+type DomainLease struct {
+	Address string `json:"address"`
+	Domain  string `json:"domain"`
+	TTL     uint32 `json:"ttl"`
+	expires time.Time
+}
+
+func NewDomainTracker(roots []string) *DomainTracker {
+	normalized := make([]string, 0, len(roots))
+	for _, root := range roots {
+		root = normalizeDomain(root)
+		if root != "" {
+			normalized = append(normalized, root)
+		}
+	}
+	return &DomainTracker{roots: normalized, leases: make(map[string]DomainLease)}
+}
+
+func (d *DomainTracker) Roots() []string {
+	if d == nil {
+		return nil
+	}
+	return append([]string(nil), d.roots...)
+}
+
+func normalizeDomain(name string) string {
+	return strings.TrimSuffix(strings.ToLower(strings.TrimSpace(name)), ".")
+}
+
+func (d *DomainTracker) allowed(name string) bool {
+	name = normalizeDomain(name)
+	for _, root := range d.roots {
+		if name == root || strings.HasSuffix(name, "."+root) {
+			return true
+		}
+	}
+	return false
+}
+
+func (d *DomainTracker) MatchesQuestion(message *dns.Msg) bool {
+	if d == nil || message == nil || len(message.Question) != 1 {
+		return false
+	}
+	question := message.Question[0]
+	return question.Qclass == dns.ClassINET &&
+		(question.Qtype == dns.TypeA || question.Qtype == dns.TypeAAAA) &&
+		d.allowed(question.Name)
+}
+
+func (d *DomainTracker) Learn(message *dns.Msg) bool {
+	if d == nil || message == nil {
+		return false
+	}
+	allowed := make(map[string]struct{})
+	authorityDomain := ""
+	for _, question := range message.Question {
+		if d.allowed(question.Name) {
+			domain := normalizeDomain(question.Name)
+			allowed[domain] = struct{}{}
+			if authorityDomain == "" {
+				authorityDomain = domain
+			}
+		}
+	}
+	if len(allowed) == 0 {
+		return false
+	}
+
+	// Follow only CNAMEs reachable from an allowed question. Multiple passes
+	// handle responses whose records are not ordered by chain position.
+	for range message.Answer {
+		changed := false
+		for _, answer := range message.Answer {
+			cname, ok := answer.(*dns.CNAME)
+			if !ok {
+				continue
+			}
+			if _, ok := allowed[normalizeDomain(cname.Hdr.Name)]; ok {
+				target := normalizeDomain(cname.Target)
+				if _, seen := allowed[target]; !seen {
+					allowed[target] = struct{}{}
+					changed = true
+				}
+			}
+		}
+		if !changed {
+			break
+		}
+	}
+
+	now := time.Now()
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	for address, lease := range d.leases {
+		if !lease.expires.After(now) {
+			delete(d.leases, address)
+		}
+	}
+	learned := false
+	for _, answer := range message.Answer {
+		if _, ok := allowed[normalizeDomain(answer.Header().Name)]; !ok {
+			continue
+		}
+		record, ok := answer.(*dns.A)
+		if !ok {
+			continue
+		}
+		address := record.A.To4()
+		if answer.Header().Ttl == 0 || address == nil {
+			continue
+		}
+		ttl := answer.Header().Ttl
+		if ttl > 120 {
+			ttl = 120
+		}
+		key := authorityDomain + "\x00" + address.String()
+		d.leases[key] = DomainLease{
+			Address: address.String(),
+			Domain:  authorityDomain,
+			TTL:     ttl,
+			expires: now.Add(time.Duration(ttl) * time.Second),
+		}
+		learned = true
+	}
+	return learned
+}
+
+func (d *DomainTracker) Snapshot() []DomainLease {
+	if d == nil {
+		return nil
+	}
+	now := time.Now()
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	result := make([]DomainLease, 0, len(d.leases))
+	for address, lease := range d.leases {
+		if !lease.expires.After(now) {
+			delete(d.leases, address)
+			continue
+		}
+		ip := net.ParseIP(lease.Address)
+		if ip == nil || ip.To4() == nil {
+			continue
+		}
+		remaining := uint32(time.Until(lease.expires).Seconds())
+		if remaining == 0 {
+			remaining = 1
+		}
+		lease.TTL = remaining
+		lease.expires = time.Time{}
+		result = append(result, lease)
+	}
+	return result
+}
+
+func (d *DomainTracker) Contains(address net.IP) bool {
+	if d == nil || address == nil {
+		return false
+	}
+	now := time.Now()
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	wanted := address.String()
+	for key, lease := range d.leases {
+		if !lease.expires.After(now) {
+			delete(d.leases, key)
+			continue
+		}
+		if lease.Address == wanted {
+			return true
+		}
+	}
+	return false
+}
