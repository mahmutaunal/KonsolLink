diff --git a/proxy/policy.go b/proxy/policy.go
new file mode 100644
index 0000000..cca35bf
--- /dev/null
+++ b/proxy/policy.go
@@ -0,0 +1,161 @@
+package proxy
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"net"
+	"os"
+	"strconv"
+	"sync"
+	"time"
+
+	"github.com/DaniilSokolyuk/go-pcap2socks/cfg"
+	"github.com/miekg/dns"
+)
+
+const policyVersion = 1
+
+type PolicyAuthorizer interface {
+	Sync(*DomainTracker) error
+	Close() error
+}
+
+type policyUpdate struct {
+	Version    uint32        `json:"version"`
+	Type       string        `json:"type"`
+	Generation uint64        `json:"generation"`
+	Domains    []string      `json:"domains"`
+	Leases     []DomainLease `json:"leases"`
+}
+
+type policyAck struct {
+	Version    uint32 `json:"version"`
+	Generation uint64 `json:"generation"`
+	OK         bool   `json:"ok"`
+	Error      string `json:"error,omitempty"`
+}
+
+type PolicyClient struct {
+	mu         sync.Mutex
+	conn       net.Conn
+	reader     *bufio.Reader
+	generation uint64
+}
+
+func NewPolicyClientFromEnv() (*PolicyClient, error) {
+	raw := os.Getenv("KONSOLLINK_POLICY_FD")
+	if raw == "" {
+		return nil, fmt.Errorf("KONSOLLINK_POLICY_FD is required")
+	}
+	fd, err := strconv.Atoi(raw)
+	if err != nil || fd < 3 {
+		return nil, fmt.Errorf("invalid KONSOLLINK_POLICY_FD")
+	}
+	file := os.NewFile(uintptr(fd), "konsollink-policy")
+	if file == nil {
+		return nil, fmt.Errorf("open policy descriptor")
+	}
+	conn, err := net.FileConn(file)
+	_ = file.Close()
+	if err != nil {
+		return nil, fmt.Errorf("open policy connection: %w", err)
+	}
+	return &PolicyClient{conn: conn, reader: bufio.NewReaderSize(conn, 8192)}, nil
+}
+
+func (p *PolicyClient) Close() error { return p.conn.Close() }
+
+func (p *PolicyClient) Sync(tracker *DomainTracker) error {
+	if p == nil || tracker == nil {
+		return fmt.Errorf("policy synchronization is unavailable")
+	}
+	leases := tracker.Snapshot()
+	if len(leases) == 0 {
+		return nil
+	}
+	if len(leases) > 64 {
+		return fmt.Errorf("policy destination limit exceeded")
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.generation++
+	update := policyUpdate{
+		Version: policyVersion, Type: "discord_dns", Generation: p.generation,
+		Domains: tracker.Roots(), Leases: leases,
+	}
+	if err := p.conn.SetDeadline(time.Now().Add(20 * time.Second)); err != nil {
+		return err
+	}
+	if err := json.NewEncoder(p.conn).Encode(update); err != nil {
+		return fmt.Errorf("send policy update: %w", err)
+	}
+	line, err := p.reader.ReadBytes('\n')
+	if err != nil {
+		return fmt.Errorf("read policy acknowledgement: %w", err)
+	}
+	if len(line) > 4096 {
+		return fmt.Errorf("policy acknowledgement size limit")
+	}
+	var ack policyAck
+	if err := json.Unmarshal(line, &ack); err != nil {
+		return fmt.Errorf("decode policy acknowledgement: %w", err)
+	}
+	if ack.Version != policyVersion || ack.Generation != p.generation || !ack.OK {
+		return fmt.Errorf("policy update rejected: %s", ack.Error)
+	}
+	return nil
+}
+
+func BootstrapPolicy(config cfg.DNS, _ string, tracker *DomainTracker, authorizer PolicyAuthorizer) (time.Duration, error) {
+	if tracker == nil || authorizer == nil {
+		return 0, fmt.Errorf("policy bootstrap is unavailable")
+	}
+	if len(config.Servers) != 1 || config.Servers[0].Address != "local" {
+		return 0, fmt.Errorf("Discord policy bootstrap requires the local DNS resolver")
+	}
+	client := newDiscordDoHClient()
+	resolved := 0
+	var lastErr error
+	for _, root := range []string{"discord.com", "gateway.discord.gg"} {
+		if !tracker.allowed(root) {
+			return 0, fmt.Errorf("Discord policy bootstrap root %q is missing", root)
+		}
+		message := new(dns.Msg)
+		message.SetQuestion(dns.Fqdn(root), dns.TypeA)
+		response, err := client.Exchange(message)
+		if err != nil {
+			lastErr = fmt.Errorf("%s: %w", root, err)
+			continue
+		}
+		if !tracker.Learn(response) {
+			lastErr = fmt.Errorf("%s: response contained no approved IPv4 answer", root)
+			continue
+		}
+		resolved++
+	}
+	if resolved != 2 {
+		if lastErr == nil {
+			lastErr = fmt.Errorf("incomplete Discord DNS response")
+		}
+		return 0, fmt.Errorf("Discord policy bootstrap failed: %w", lastErr)
+	}
+	if err := authorizer.Sync(tracker); err != nil {
+		return 0, err
+	}
+	return policyRefreshInterval(tracker.Snapshot()), nil
+}
+
+func policyRefreshInterval(leases []DomainLease) time.Duration {
+	refresh := 45 * time.Second
+	for _, lease := range leases {
+		candidate := time.Duration(lease.TTL) * time.Second / 2
+		if candidate < refresh {
+			refresh = candidate
+		}
+	}
+	if refresh < 5*time.Second {
+		refresh = 5 * time.Second
+	}
+	return refresh
+}
diff --git a/proxy/policy_test.go b/proxy/policy_test.go
new file mode 100644
index 0000000..bf3aa19
--- /dev/null
+++ b/proxy/policy_test.go
@@ -0,0 +1,112 @@
+package proxy
+
+import (
+	"bufio"
+	"encoding/json"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/DaniilSokolyuk/go-pcap2socks/cfg"
+	M "github.com/DaniilSokolyuk/go-pcap2socks/md"
+	"github.com/miekg/dns"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestPolicySyncCarriesBoundedDiscordDNSAuthority(t *testing.T) {
+	tracker := NewDomainTracker([]string{"discord.com"})
+	answer := new(dns.Msg)
+	answer.SetQuestion("gateway.discord.com.", dns.TypeA)
+	answer.Answer = []dns.RR{&dns.A{
+		Hdr: dns.RR_Header{Name: "gateway.discord.com.", Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 600},
+		A:   net.IPv4(203, 0, 113, 25),
+	}}
+	tracker.Learn(answer)
+
+	clientConn, serverConn := net.Pipe()
+	client := &PolicyClient{conn: clientConn, reader: bufio.NewReaderSize(clientConn, 8192)}
+	done := make(chan error, 1)
+	go func() {
+		defer serverConn.Close()
+		line, err := bufio.NewReader(serverConn).ReadBytes('\n')
+		if err != nil {
+			done <- err
+			return
+		}
+		var update policyUpdate
+		if err := json.Unmarshal(line, &update); err != nil {
+			done <- err
+			return
+		}
+		assert.Equal(t, uint32(1), update.Version)
+		assert.Equal(t, "discord_dns", update.Type)
+		require.Len(t, update.Leases, 1)
+		assert.Equal(t, "gateway.discord.com", update.Leases[0].Domain)
+		assert.LessOrEqual(t, update.Leases[0].TTL, uint32(120))
+		done <- json.NewEncoder(serverConn).Encode(policyAck{
+			Version: 1, Generation: update.Generation, OK: true,
+		})
+	}()
+	require.NoError(t, client.Sync(tracker))
+	require.NoError(t, <-done)
+	require.NoError(t, client.Close())
+}
+
+func TestPolicyRefreshPrecedesTheShortestLeaseExpiry(t *testing.T) {
+	assert.Equal(t, 17*time.Second, policyRefreshInterval([]DomainLease{{TTL: 120}, {TTL: 34}}))
+	assert.Equal(t, 5*time.Second, policyRefreshInterval([]DomainLease{{TTL: 3}}))
+	assert.Equal(t, 45*time.Second, policyRefreshInterval([]DomainLease{{TTL: 120}}))
+}
+
+type gateAuthorizer struct {
+	entered chan struct{}
+	release chan struct{}
+}
+
+func (g *gateAuthorizer) Sync(*DomainTracker) error {
+	close(g.entered)
+	<-g.release
+	return nil
+}
+func (g *gateAuthorizer) Close() error { return nil }
+
+type dnsExchangeFunc func(*dns.Msg) (*dns.Msg, error)
+
+func (f dnsExchangeFunc) Exchange(message *dns.Msg) (*dns.Msg, error) { return f(message) }
+
+func TestDNSAnswerWaitsForPolicyAcknowledgement(t *testing.T) {
+	upstream := startDNSServer(t, net.IPv4(203, 0, 113, 26))
+	tracker := NewDomainTracker([]string{"discord.com"})
+	gate := &gateAuthorizer{entered: make(chan struct{}), release: make(chan struct{})}
+	config := cfg.DNS{Servers: []struct {
+		Address string `json:"address"`
+	}{{Address: upstream}}}
+	metadata := &M.Metadata{Network: M.UDP, DstIP: net.IPv4(1, 1, 1, 1), DstPort: 53}
+	p := NewDNS(config, "", tracker, gate)
+	p.discordDNS = dnsExchangeFunc(func(message *dns.Msg) (*dns.Msg, error) {
+		response, _, err := new(dns.Client).Exchange(message, upstream)
+		return response, err
+	})
+	pc, err := p.DialUDP(metadata)
+	require.NoError(t, err)
+	defer pc.Close()
+	query := new(dns.Msg)
+	query.SetQuestion("discord.com.", dns.TypeA)
+	packed, err := query.Pack()
+	require.NoError(t, err)
+	_, err = pc.WriteTo(packed, metadata.UDPAddr())
+	require.NoError(t, err)
+	select {
+	case <-gate.entered:
+	case <-time.After(2 * time.Second):
+		t.Fatal("policy authorizer was not called")
+	}
+	require.NoError(t, pc.SetReadDeadline(time.Now().Add(50*time.Millisecond)))
+	_, _, err = pc.ReadFrom(make([]byte, 4096))
+	require.Error(t, err)
+	close(gate.release)
+	require.NoError(t, pc.SetReadDeadline(time.Now().Add(2*time.Second)))
+	_, _, err = pc.ReadFrom(make([]byte, 4096))
+	require.NoError(t, err)
+}
