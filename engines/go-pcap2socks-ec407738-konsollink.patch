+func TestRouterDomainRuleKeepsUnlearnedTCPDirect(t *testing.T) {
+	var picked string
+	proxies := map[string]Proxy{
+		"":      &recordingProxy{Base: &Base{}, tag: "direct", picked: &picked},
+		"socks": &recordingProxy{Base: &Base{}, tag: "socks", picked: &picked},
+	}
+	tracker := NewDomainTracker([]string{"discord.net"})
+	router := NewRouter([]cfg.Rule{
+		mustRule(t, cfg.Rule{Network: "tcp", DstPort: "80,443", DstDomain: []string{"discord.net"}, OutboundTag: "socks"}),
+	}, proxies, tracker)
+	destination := net.ParseIP("203.0.113.77")
+	flow := metadata("172.26.0.5", 40000, destination.String(), 443)
+	_, err := router.DialContext(context.Background(), flow)
+	require.NoError(t, err)
+	assert.Equal(t, "direct", picked)
+
+	answer := new(dns.Msg)
+	answer.SetQuestion("gateway.discord.net.", dns.TypeA)
+	answer.Answer = []dns.RR{&dns.A{
+		Hdr: dns.RR_Header{Name: "gateway.discord.net.", Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 60},
+		A:   destination,
+	}}
+	tracker.Learn(answer)
+	picked = ""
+	_, err = router.DialContext(context.Background(), flow)
+	require.NoError(t, err)
+	assert.Equal(t, "socks", picked)
+}
