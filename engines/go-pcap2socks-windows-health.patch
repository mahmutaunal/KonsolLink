+//go:build windows
+
+package main
+
+import (
+	"context"
+	"crypto/subtle"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"strconv"
+	"sync"
+	"time"
+
+	"github.com/DaniilSokolyuk/go-pcap2socks/engine"
+	M "github.com/DaniilSokolyuk/go-pcap2socks/md"
+)
+
+// A service-owned, authenticated loopback endpoint. It is read-only and never
+// receives console payloads or changes routing. No listener without opt-in.
+func startPlatformHealth(eng *engine.Engine, iface net.Interface) (func(), error) {
+	addr, token := os.Getenv("KONSOLLINK_HEALTH_ADDR"), os.Getenv("KONSOLLINK_HEALTH_TOKEN")
+	if addr == "" && token == "" {
+		return func() {}, nil
+	}
+	host, port, err := net.SplitHostPort(addr)
+	if err != nil || host != "127.0.0.1" || len(token) != 64 {
+		return nil, fmt.Errorf("invalid service health endpoint")
+	}
+	if n, err := strconv.Atoi(port); err != nil || n < 1 || n > 65535 {
+		return nil, fmt.Errorf("invalid service health port")
+	}
+	initial, err := iface.Addrs()
+	if err != nil {
+		return nil, fmt.Errorf("health interface addresses: %w", err)
+	}
+	listener, err := net.Listen("tcp4", addr)
+	if err != nil {
+		return nil, fmt.Errorf("health listen: %w", err)
+	}
+	var probe sync.Mutex
+	mux := http.NewServeMux()
+	mux.HandleFunc("/health", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet || subtle.ConstantTimeCompare([]byte(r.Header.Get("Authorization")), []byte("Bearer "+token)) != 1 {
+			http.Error(w, "unauthorized", http.StatusUnauthorized)
+			return
+		}
+		if !probe.TryLock() {
+			http.Error(w, "probe busy", http.StatusServiceUnavailable)
+			return
+		}
+		defer probe.Unlock()
+		local, reason := true, ""
+		select {
+		case <-eng.Done():
+			local, reason = false, "capture stopped"
+		default:
+		}
+		current, err := net.InterfaceByIndex(iface.Index)
+		if err != nil || current == nil || current.Flags&net.FlagUp == 0 || current.HardwareAddr.String() != iface.HardwareAddr.String() {
+			local, reason = false, "capture interface unavailable"
+		} else {
+			addrs, err := current.Addrs()
+			if err != nil || !sameAddresses(initial, addrs) {
+				local, reason = false, "capture interface addresses changed"
+			}
+		}
+		discord, internet := false, false
+		if local {
+			discord = routedHTTPS(r.Context(), eng, "https://discord.com/api/v10/gateway")
+			internet = routedHTTPS(r.Context(), eng, "https://www.microsoft.com/")
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(struct {
+			Schema   int    `json:"schema"`
+			PID      int    `json:"pid"`
+			Local    bool   `json:"local_ok"`
+			Discord  bool   `json:"discord_ok"`
+			Internet bool   `json:"internet_ok"`
+			Reason   string `json:"reason"`
+		}{1, os.Getpid(), local, discord, internet, reason})
+	})
+	server := &http.Server{Handler: mux, ReadHeaderTimeout: time.Second, WriteTimeout: 10 * time.Second, IdleTimeout: time.Second, MaxHeaderBytes: 2048}
+	go func() { _ = server.Serve(listener) }()
+	return func() { _ = server.Close() }, nil
+}
+
+func sameAddresses(a, b []net.Addr) bool {
+	// IPv4 topology only: unrelated temporary IPv6 address changes must not
+	// restart this explicitly IPv4 gateway.
+	ipv4 := func(values []net.Addr) map[string]bool {
+		m := map[string]bool{}
+		for _, v := range values {
+			if ip, ok := v.(*net.IPNet); ok && ip.IP.To4() != nil {
+				m[ip.String()] = true
+			}
+		}
+		return m
+	}
+	x, y := ipv4(a), ipv4(b)
+	if len(x) != len(y) {
+		return false
+	}
+	for k := range x {
+		if !y[k] {
+			return false
+		}
+	}
+	return len(x) > 0
+}
+
+func routedHTTPS(parent context.Context, eng *engine.Engine, url string) bool {
+	ctx, cancel := context.WithTimeout(parent, 4*time.Second)
+	defer cancel()
+	transport := &http.Transport{Proxy: nil, DisableKeepAlives: true, TLSHandshakeTimeout: 2 * time.Second, ResponseHeaderTimeout: 2 * time.Second,
+		DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
+			host, port, err := net.SplitHostPort(address)
+			if err != nil {
+				return nil, err
+			}
+			ips, err := net.DefaultResolver.LookupIP(ctx, "ip4", host)
+			if err != nil {
+				return nil, err
+			}
+			p, err := strconv.ParseUint(port, 10, 16)
+			if err != nil {
+				return nil, err
+			}
+			var last error
+			for _, ip := range ips {
+				conn, err := eng.Proxy.DialContext(ctx, &M.Metadata{Network: M.TCP, SrcIP: net.IPv4(172, 24, 2, 10), DstIP: ip, DstPort: uint16(p)})
+				if err == nil {
+					return conn, nil
+				}
+				last = err
+			}
+			if last == nil {
+				last = fmt.Errorf("no IPv4 address")
+			}
+			return nil, last
+		},
+	}
+	defer transport.CloseIdleConnections()
+	client := &http.Client{Transport: transport, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
+	if err != nil {
+		return false
+	}
+	response, err := client.Do(req)
+	if err != nil {
+		return false
+	}
+	defer response.Body.Close()
+	_, err = io.Copy(io.Discard, io.LimitReader(response.Body, 1024))
+	return err == nil && response.StatusCode >= 200 && response.StatusCode < 400
+}
