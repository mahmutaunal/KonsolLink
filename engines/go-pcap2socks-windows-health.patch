+//go:build windows
+
+package main
+
+import (
+	"encoding/json"
+	"net"
+	"net/http"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/DaniilSokolyuk/go-pcap2socks/cfg"
+	"github.com/DaniilSokolyuk/go-pcap2socks/core/device"
+	"github.com/DaniilSokolyuk/go-pcap2socks/engine"
+)
+
+func TestHealthIPv4TopologyIgnoresTemporaryIPv6(t *testing.T) {
+	addr := func(s string) net.Addr {
+		ip, n, e := net.ParseCIDR(s)
+		if e != nil {
+			t.Fatal(e)
+		}
+		n.IP = ip
+		return n
+	}
+	a := []net.Addr{addr("192.168.1.4/24"), addr("2001:db8::1/64")}
+	b := []net.Addr{addr("192.168.1.4/24"), addr("2001:db9::1/64")}
+	if !sameAddresses(a, b) {
+		t.Fatal("IPv6 change invalidated IPv4 session")
+	}
+	if sameAddresses(a, []net.Addr{addr("192.168.2.4/24")}) {
+		t.Fatal("IPv4 change was missed")
+	}
+}
+
+func TestHealthEndpointDisabledAndRejectsPublicBind(t *testing.T) {
+	t.Setenv("KONSOLLINK_HEALTH_ADDR", "")
+	t.Setenv("KONSOLLINK_HEALTH_TOKEN", "")
+	close, err := startPlatformHealth(nil, net.Interface{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	close()
+	t.Setenv("KONSOLLINK_HEALTH_ADDR", "0.0.0.0:8085")
+	t.Setenv("KONSOLLINK_HEALTH_TOKEN", strings.Repeat("a", 64))
+	if _, err = startPlatformHealth(nil, net.Interface{}); err == nil {
+		t.Fatal("public bind accepted")
+	}
+}
+
+func TestHealthEndpointAuthenticationAndStoppedCapture(t *testing.T) {
+	interfaces, err := net.Interfaces()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var iface net.Interface
+	for _, i := range interfaces {
+		addrs, _ := i.Addrs()
+		if len(addrs) > 0 {
+			iface = i
+			break
+		}
+	}
+	if iface.Index == 0 {
+		t.Fatal("test requires an interface")
+	}
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	address := listener.Addr().String()
+	listener.Close()
+	t.Setenv("KONSOLLINK_HEALTH_ADDR", address)
+	t.Setenv("KONSOLLINK_HEALTH_TOKEN", strings.Repeat("a", 64))
+	_, network, _ := net.ParseCIDR("172.24.0.0/16")
+	source := device.NewMemSource(1)
+	eng, err := engine.Start(engine.Options{Config: &cfg.Config{Outbounds: []cfg.Outbound{{Direct: &cfg.OutboundDirect{}}}}, Interface: iface, Source: source, Network: &device.NetworkConfig{Network: network, LocalIP: net.IPv4(172, 24, 2, 1), LocalMAC: net.HardwareAddr{2, 0, 0, 0, 0, 1}, MTU: 1486}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer eng.Close()
+	closeHealth, err := startPlatformHealth(eng, iface)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer closeHealth()
+	client := &http.Client{Timeout: time.Second}
+	response, err := client.Get("http://" + address + "/health")
+	if err != nil {
+		t.Fatal(err)
+	}
+	response.Body.Close()
+	if response.StatusCode != http.StatusUnauthorized {
+		t.Fatal("unauthenticated request accepted")
+	}
+	source.Close()
+	select {
+	case <-eng.Done():
+	case <-time.After(time.Second):
+		t.Fatal("capture did not stop")
+	}
+	request, _ := http.NewRequest(http.MethodGet, "http://"+address+"/health", nil)
+	request.Header.Set("Authorization", "Bearer "+strings.Repeat("a", 64))
+	response, err = client.Do(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	var result struct {
+		Schema int  `json:"schema"`
+		PID    int  `json:"pid"`
+		Local  bool `json:"local_ok"`
+	}
+	if err = json.NewDecoder(response.Body).Decode(&result); err != nil {
+		t.Fatal(err)
+	}
+	if result.Schema != 1 || result.PID != os.Getpid() || result.Local {
+		t.Fatal("stopped capture reported healthy", result)
+	}
+}
